{
  "extends": ["//"],
  "tasks": {
    "prisma": {}
  },
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "SECRET_JWT",
        "MAIL_USER",
        "MAIL_PASS",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "BASE_API_URL",
        "BASE_FE_URL",
        "NODE_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "serve": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    }
  }
  
}