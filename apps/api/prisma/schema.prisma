generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enum for User role
enum UserRole {
  normal
  candidate
  admin
  developer
}

// Enum for Application Status
enum ApplicationStatus {
  active
  under_review
  interview
  pending
  accepted
  hired
  rejected
}

// Enum for Interview Status
enum InterviewStatus {
  scheduled
  completed
  canceled
}

// Enum for Subscription Status (naufal)
enum SubscriptionStatus {
  active
  inactive
}

// Enum for Assessment Status (naufal)
enum AssessmentStatus {
  passed
  failed
}

// Enum for Question Type
enum QuestionType {
  multiple_choice
  true_false
  open_ended
}

// Enum for Difficulty Level
enum DifficultyLevel {
  easy
  medium
  hard
}

// Enum for Notification Type
enum NotificationType {
  application
  interview
  subscription
}

// Enum for Proficiency Level
enum ProficiencyLevel {
  beginner
  intermediate
  advanced
}

// Enum for Log Status
enum LogStatus {
  success
  failure
}

// Enum for Report Status
enum ReportStatus {
  pending
  resolved
  dismissed
}

// Enum for Device Type
enum DeviceType {
  desktop
  mobile
  tablet
}

// Enum for Transaction Status (naufal)
enum TransactionStatus {
  pending
  completed
  failed
}

// Enum for Payment Method
enum PaymentMethod {
  bank_transfer
  credit_card
  paypal
}

// Enum for Interview Type
enum InterviewType {
  in_person
  virtual
}

// Enum for Education
enum EducationLevel {
  HIGH_SCHOOL
  ASSOCIATES
  BACHELORS
  MASTERS
  DOCTORATE
  DIPLOMA
  VOCATIONAL
  CERTIFICATION
  SOME_COLLEGE
  POSTGRADUATE
}

// Enum for Gender
enum Gender {
  MALE
  FEMALE
  OTHER
}

// Enum for Job Type
enum JobType {
  fullTime
  partTime
  freelance
  contractor
}

// Enum for Country Code
enum CountryCode {
  ID // Indonesia
  SG // Singapore
  MY // Malaysia
  US // United States
  GB // United Kingdom
  DE // Germany
  JP // Japan
  CN // China
}

// Enum for Job education
enum JobEducationLevel {
  high_school
  intermediate
  graduate
  bachelor_degree
  master_degree
  doctor_degree
}

// Enum for Job Experience
enum JobExperience {
  entry_level
  mid_level
  senior_level
  expert
}

// Enum for Job Category
enum JobCategory {
  software_engineering
  data_science
  machine_learning
  artificial_intelligence
  cybersecurity
  business_intelligence
  cyber_security
  product_management
  marketing
  design
  finance
  accounting
  legal
  management
  human_resources
  customer_service
  sales
  legal_and_compliance
  management_and_leadership
  public_relations
}

enum IndustryType {
  TECHNOLOGY
  FINANCE
  HEALTHCARE
  EDUCATION
  RETAIL
  HOSPITALITY
  TRANSPORTATION
  CONSTRUCTION
  REAL_ESTATE
  CONSULTING
  GOVERNMENT
  ENERGY
  TELECOMMUNICATIONS
  ENTERTAINMENT
  AGRICULTURE
  MANUFACTURING
  INSURANCE
  LEGAL
  MARKETING
  ADVERTISING
  MEDIA
  NON_PROFIT
  RESEARCH
  AUTOMOTIVE
  PHARMACEUTICALS
}

// User model
model User {
  user_id             String          @id @default(auto()) @map("_id") @db.ObjectId
  email               String          @unique
  password            String
  role                UserRole
  first_name          String
  last_name           String
  profile_picture     String?
  phone               String?
  website             String?
  linkedin            String?
  github              String?
  twitter             String?
  facebook            String?
  instagram           String?
  title               String?
  education           EducationLevel?
  biography           String?
  skills              String?
  languages           String?
  nationality         String?
  country             CountryCode?
  location            String?
  gender              Gender?
  tempat_lahir        String?
  DateOfBirth         DateTime?
  resume              String?
  years_of_experience Int?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  is_verified         Boolean

  // Relations
  applications            Application[]
  companies               Company[]                @relation("UserCompanies", fields: [company_ids], references: [company_id])
  company_ids             String[] @db.ObjectId
  skillAssessments        SkillAssessment[]
  reviews                 Review[]
  notifications           Notification[]
  subscriptions           Subscription[]
  userSkills              UserSkill[]
  adminLogs               AdminLog[]
  jobReports              JobReport[]
  jobViews                JobView[]
  jobSaves                JobSave[]
  paymentTransactions     PaymentTransaction[]
  UserAssessmentResponses UserAssessmentResponse[]
  jobs                    Job[]
  Favorite                Favorite[]
  testResults             TestResult[]
  answers                 TestAnswer[]
  CV                      CV[]
  featureUsage            FeatureUsage[]
  SubscriptionType        SubscriptionType[]
  UserAssessmentScore     UserAssessmentScore[]
}

// Company model
model Company {
  company_id      String        @id @default(auto()) @map("_id") @db.ObjectId
  company_name    String
  email           String        @unique
  phone           String?
  aboutUs         String?
  website         String?
  linkedin        String?
  instagram       String?
  twitter         String?
  facebook        String?
  yearOfEstablish String?
  IndustryType    IndustryType?
  TeamSize        String?
  country         CountryCode
  address         String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  description     String?
  logo            String?
  banner          String?

  // Relations
  jobs    Job[]
  reviews Review[]
  users   User[]   @relation("UserCompanies", fields: [user_ids], references: [user_id])
  user_ids String[] @db.ObjectId
}

// Job model
model Job {
  job_id            String             @id @default(auto()) @map("_id") @db.ObjectId
  job_title         String
  description       String
  responsibility    String?
  country           CountryCode
  location          String?
  salary            Int?
  jobType           JobType?
  jobCategory       JobCategory?
  jobEducationLevel JobEducationLevel?
  jobExperience     JobExperience?
  jobExpired_at     DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  is_active         Boolean

  // Relations
  company          Company           @relation(fields: [company_id], references: [company_id])
  company_id       String            @db.ObjectId
  applications     Application[]
  jobReports       JobReport[]
  jobViews         JobView[]
  jobSaves         JobSave[]
  user             User?             @relation(fields: [user_id], references: [user_id])
  user_id          String?           @db.ObjectId
  Favorite         Favorite[]
  preSelectionTest PreSelectionTest?
  testResults      TestResult[]

  @@index([company_id])
  @@index([is_active, jobCategory])
  @@index([user_id], map: "Job_userUser_id_fkey")
}

model Favorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String   @db.ObjectId
  job_id     String   @db.ObjectId
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id])
  job  Job  @relation(fields: [job_id], references: [job_id])

  @@unique([user_id, job_id])
}

// Application model
model Application {
  application_id   String            @id @default(auto()) @map("_id") @db.ObjectId
  resume           String?
  coverLetter      String?
  expected_salary  Float?
  status           ApplicationStatus
  applied_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  interview_date   DateTime?
  interview_time   DateTime?
  interview_status InterviewStatus?

  // Relations
  job       Job         @relation(fields: [job_id], references: [job_id])
  job_id    String      @db.ObjectId
  user      User        @relation(fields: [user_id], references: [user_id])
  user_id   String      @db.ObjectId
  interview Interview[]

  @@index([job_id])
  @@index([user_id])
}

// Notification model
model Notification {
  notification_id String           @id @default(auto()) @map("_id") @db.ObjectId
  user            User             @relation(fields: [user_id], references: [user_id])
  user_id         String           @db.ObjectId
  subject         String?
  message         String
  is_read         Boolean
  type            NotificationType
  related_id      String?
  link            String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@index([user_id])
}

// UserSkill model
model UserSkill {
  user_skill_id       String            @id @default(auto()) @map("_id") @db.ObjectId
  user                User              @relation(fields: [user_id], references: [user_id])
  user_id             String            @db.ObjectId
  skill_name          String
  years_of_experience Int?
  proficiency_level   ProficiencyLevel?
  certification       String?
  description         String?
  is_verified         Boolean
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([user_id])
}

// AdminLog model
model AdminLog {
  log_id           String     @id @default(auto()) @map("_id") @db.ObjectId
  action           String
  timestamp        DateTime   @default(now())
  details          String?
  ip_address       String?
  user_agent       String?
  status           LogStatus?
  affected_user_id String?
  admin            User       @relation(fields: [admin_id], references: [user_id])
  admin_id         String     @db.ObjectId
  affected_job_id  String?

  @@index([admin_id])
}

// JobReport model
model JobReport {
  report_id       String       @id @default(auto()) @map("_id") @db.ObjectId
  job             Job          @relation(fields: [job_id], references: [job_id])
  job_id          String       @db.ObjectId
  user            User         @relation(fields: [user_id], references: [user_id])
  user_id         String       @db.ObjectId
  reason          String
  status          ReportStatus
  admin_response  String?
  is_anonymous    Boolean
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  resolution_date DateTime?

  @@index([job_id])
  @@index([user_id])
}

// JobView model
model JobView {
  view_id     String      @id @default(auto()) @map("_id") @db.ObjectId
  job         Job         @relation(fields: [job_id], references: [job_id])
  job_id      String      @db.ObjectId
  user        User?       @relation(fields: [user_id], references: [user_id])
  user_id     String?     @db.ObjectId
  viewed_at   DateTime    @default(now())
  ip_address  String?
  user_agent  String?
  location    String?
  device_type DeviceType?
  referrer    String?
  session_id  String?

  @@index([job_id])
}

// JobSave model
model JobSave {
  save_id         String    @id @default(auto()) @map("_id") @db.ObjectId
  job             Job       @relation(fields: [job_id], references: [job_id])
  job_id          String    @db.ObjectId
  user            User      @relation(fields: [user_id], references: [user_id])
  user_id         String    @db.ObjectId
  saved_at        DateTime  @default(now())
  is_favorite     Boolean
  notes           String?
  expiration_date DateTime?
  reminder_set    Boolean
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([job_id])
  @@index([user_id])
}

// Interview model
model Interview {
  interview_id     String          @id @default(auto()) @map("_id") @db.ObjectId
  application      Application     @relation(fields: [application_id], references: [application_id])
  application_id   String          @db.ObjectId
  scheduled_time   DateTime
  status           InterviewStatus
  feedback         String?
  interviewer_name String?
  interview_link   String?
  interview_type   InterviewType?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  @@index([application_id])
}

model PreSelectionTest {
  test_id   String         @id @default(auto()) @map("_id") @db.ObjectId
  job_id    String         @unique @db.ObjectId
  questions TestQuestion[]
  answers   TestAnswer[]
  job       Job            @relation(fields: [job_id], references: [job_id])
  skillAssessment SkillAssessment @relation(fields: [assessment_id], references: [assessment_id])
  assessment_id   String          @db.ObjectId
}

model TestQuestion {
  question_id      String           @id @default(auto()) @map("_id") @db.ObjectId
  test_id          String           @db.ObjectId
  question_text    String
  options          TestOption[]
  correct_answer   Int
  preSelectionTest PreSelectionTest @relation(fields: [test_id], references: [test_id])
  answers          TestAnswer[]
}

model TestResult {
  result_id    String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @db.ObjectId
  job_id       String   @db.ObjectId
  score        Int
  completed_at DateTime @default(now())
  job          Job      @relation(fields: [job_id], references: [job_id])
  user         User     @relation(fields: [user_id], references: [user_id])
}

model TestOption {
  option_id    String       @id @default(auto()) @map("_id") @db.ObjectId
  question_id  String       @db.ObjectId
  option_text  String
  testQuestion TestQuestion @relation(fields: [question_id], references: [question_id])
}

model TestAnswer {
  answer_id       String           @id @default(auto()) @map("_id") @db.ObjectId
  user_id         String           @db.ObjectId
  question_id     String           @db.ObjectId
  test_id         String           @db.ObjectId
  selected_option Int
  is_correct      Boolean
  answered_at     DateTime @default(now())

  user             User             @relation(fields: [user_id], references: [user_id])
  preSelectionTest PreSelectionTest @relation(fields: [test_id], references: [test_id])
  testQuestion     TestQuestion     @relation(fields: [question_id], references: [question_id])
}

model SubscriptionType {
  subs_type_id       String               @id @default(auto()) @map("_id") @db.ObjectId
  type               String
  description        String
  price              Float
  features           Json
  User_id            String?              @db.ObjectId
  is_recomend        Boolean              @default(false)
  PaymentTransaction PaymentTransaction[]
  subscriptions      Subscription[]
  User               User?                @relation(fields: [User_id], references: [user_id])

  @@index([User_id], map: "SubscriptionType_User_id_fkey")
}

model Subscription {
  subscription_id      String               @id @default(auto()) @map("_id") @db.ObjectId
  start_date           DateTime?
  end_date             DateTime?
  status               SubscriptionStatus?
  payment_proof        Boolean?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  amount               Float?
  user_id              String?              @db.ObjectId
  subscription_type_id String               @db.ObjectId
  paymentTransactions  PaymentTransaction[]
  subscriptionType     SubscriptionType     @relation(fields: [subscription_type_id], references: [subs_type_id])
  user                 User?                @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([status, end_date])
  @@index([subscription_type_id], map: "Subscription_subscription_type_id_fkey")
}

model Review {
  review_id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  rating                    Float?
  comment                   String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  salary_estimate           Float?
  position                  String?
  user_id                   String   @db.ObjectId
  company_id                String   @db.ObjectId
  careerOpportunitiesRating Int
  facilitiesRating          Int
  workCultureRating         Int
  workLifeBalanceRating     Int
  company                   Company  @relation(fields: [company_id], references: [company_id])
  user                      User     @relation(fields: [user_id], references: [user_id])

  @@index([company_id])
  @@index([user_id])
}

model SkillAssessment {
  assessment_id   String                   @id @default(auto()) @map("_id") @db.ObjectId
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt
  assessment_data Json?
  start_date      DateTime?
  feedback        String?

  // Relations
  user                 User                     @relation(fields: [user_id], references: [user_id])
  user_id              String                   @db.ObjectId
  questions            AssessmentQuestion[]
  userResponses        UserAssessmentResponse[]
  userAssessmentScores UserAssessmentScore[]
  preSelectionTests    PreSelectionTest[]

  @@index([user_id])
}

model AssessmentQuestion {
  question_id            String                   @id @default(auto()) @map("_id") @db.ObjectId
  question_text          String
  question_type          QuestionType             @default(multiple_choice)
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  is_active              Boolean
  difficulty_level       DifficultyLevel?
  points                 Int?
  assessment_id          String                   @db.ObjectId
  answers                AssessmentAnswer[]
  skillAssessment        SkillAssessment          @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
  UserAssessmentResponse UserAssessmentResponse[]
  UserAssessmentScore    UserAssessmentScore[]

  @@index([assessment_id])
}

model AssessmentAnswer {
  answer_id              String                   @id @default(auto()) @map("_id") @db.ObjectId
  answer_text            String
  is_correct             Boolean?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  question_id            String                   @db.ObjectId
  question               AssessmentQuestion       @relation(fields: [question_id], references: [question_id], onDelete: Cascade)
  UserAssessmentResponse UserAssessmentResponse[]
  UserAssessmentScore    UserAssessmentScore[]

  @@index([question_id])
}

model UserAssessmentResponse {
  response_id   String             @id @default(auto()) @map("_id") @db.ObjectId
  answer_text   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  user            User               @relation(fields: [user_id], references: [user_id])
  user_id         String             @db.ObjectId
  question        AssessmentQuestion @relation(fields: [question_id], references: [question_id])
  question_id     String             @db.ObjectId
  answer          AssessmentAnswer?  @relation(fields: [answer_id], references: [answer_id])
  answer_id       String?            @db.ObjectId
  skillAssessment SkillAssessment    @relation(fields: [assessment_id], references: [assessment_id])
  assessment_id   String             @db.ObjectId

  @@index([user_id])
  @@index([question_id])
  @@index([assessment_id])
}

model UserAssessmentScore {
  score_id      String           @id @default(auto()) @map("_id") @db.ObjectId
  badge         String?
  score         Int?             @default(0)
  status        AssessmentStatus @default(failed)
  unique_code   String           @unique @default(uuid()) // Tambahkan field ini
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  // Relations
  user                          User                @relation(fields: [user_id], references: [user_id])
  user_id                       String              @db.ObjectId
  skillAssessment               SkillAssessment     @relation(fields: [assessment_id], references: [assessment_id])
  assessment_id                 String              @db.ObjectId
  AssessmentQuestion            AssessmentQuestion? @relation(fields: [assessmentQuestionQuestion_id], references: [question_id])
  assessmentQuestionQuestion_id String?             @db.ObjectId
  AssessmentAnswer              AssessmentAnswer?   @relation(fields: [assessmentAnswerAnswer_id], references: [answer_id])
  assessmentAnswerAnswer_id     String?             @db.ObjectId

  @@index([user_id])
  @@index([assessment_id])
}

model FeatureUsage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @db.ObjectId
  feature_name String
  used_at      DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [user_id])

  @@index([user_id, feature_name])
}

model CV {
  cv_id      String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String   @db.ObjectId
  template   String   @default("ATS")
  content    Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
}

model PaymentTransaction {
  transaction_id       String            @id @default(auto()) @map("_id") @db.ObjectId
  user_id              String            @db.ObjectId
  amount               Float
  transaction_date     DateTime          @default(now())
  status               TransactionStatus @default(pending)
  payment_method       PaymentMethod?    @default(bank_transfer)
  receipt              String?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  subscription_id      String?           @db.ObjectId
  subscription_type_id String            @db.ObjectId
  subscription         Subscription?     @relation(fields: [subscription_id], references: [subscription_id])
  subscriptionType     SubscriptionType  @relation(fields: [subscription_type_id], references: [subs_type_id])
  user                 User              @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([subscription_id], map: "PaymentTransaction_subscription_id_fkey")
  @@index([subscription_type_id], map: "PaymentTransaction_subscription_type_id_fkey")
}